# Clave de la API de Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Token para entrar al panel interno (/panel). Usá uno largo y secreto.
ADMIN_TOKEN=

# Puerto del servidor
PORT=3000

# 1 = modo demo (respuestas simuladas, sin costo). Dejalo vacío en producción.
ESCALA_MOCK=

# 0 = no auditar automáticamente las tiendas que dejan los leads
AUTO_AUDIT=1

# Trabajos de agentes en paralelo (total) y por cliente
MAX_JOBS=4
MAX_JOBS_POR_CLIENTE=1

# Webhook opcional (Make, Zapier, n8n) para recibir leads y trabajos terminados
WEBHOOK_URL=

# Datos de la agencia que el asesor del chat puede compartir
AGENCIA_NOMBRE=Escalá Growth Studio
AGENCIA_WHATSAPP=
AGENCIA_EMAIL=

# Modelo de Claude para todos los agentes
ESCALA_MODEL=claude-opus-5-5

# --- Operación autónoma ---
# Límite de gasto diario en la API (USD). Al llegar, los trabajos se pausan y se retoman al día siguiente.
PRESUPUESTO_DIARIO_USD=20
# Puntaje mínimo del control de calidad para entregar sin intervención humana (0-100)
UMBRAL_CALIDAD=80
# Rondas de autocorrección antes de escalar a una persona
MAX_REVISIONES=2
# Reintentos ante errores transitorios (red, límites de la API) y espera inicial en ms
MAX_INTENTOS=4
ESPERA_REINTENTO_MS=30000
# Ventana en la que se planifica el contenido y los anuncios del mes siguiente:
# cada cliente tiene un día fijo entre DIA_PLANIFICACION y DIA_PLANIFICACION + VENTANA_PLANIFICACION - 1
DIA_PLANIFICACION=20
VENTANA_PLANIFICACION=6
# La re-auditoría mensual se reparte entre el día 1 y el día VENTANA_REAUDITORIA
VENTANA_REAUDITORIA=10
# Días sin métricas antes de avisar que falta el reporte semanal
DIAS_SIN_METRICAS=8
# Días sin movimiento antes de redactar un seguimiento, y máximo de seguimientos por lead
DIAS_SEGUIMIENTO=3
MAX_SEGUIMIENTOS=2
# Token para que Make/Zapier/n8n envíen métricas a /api/ingesta/metricas
INGESTA_TOKEN=
# 0 = apagar la agenda automática
AGENDA=1
# 1 si el servidor está detrás de un proxy (Railway, Render, Nginx)
TRUST_PROXY=

# --- Escala ---
# Base de datos SQLite (por defecto data/escala.db). Se migra sola desde data/db.json.
DB_FILE=
# Copias de seguridad diarias en data/backups (0 = apagar) y cuántas guardar
BACKUPS=1
BACKUPS_A_GUARDAR=14
# Pausa de toda la cola cuando la API limita el ritmo (ms)
PAUSA_LIMITE_MS=60000
