# --- Claude (IA) ---
ANTHROPIC_API_KEY=
# Modelo: claude-opus-5-5 (el más capaz), claude-sonnet-5-5 (intermedio), claude-haiku-5-5 (el más barato y rápido)
CLAUDE_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low = más rápido y barato; medium si notás errores
CLAUDE_EFFORT=low

# --- WhatsApp (uno solo para todos los locales) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=elegi-una-palabra-secreta
GRAPH_API_VERSION=v23.0

# --- Secretos de cada local (los lee clientes/<local>/negocio.json con "env:NOMBRE") ---
ASTROBURGUER_WA_PHONE_ID=
ASTROBURGUER_WA_TOKEN=
ASTROBURGUER_PANEL_TOKEN=
# Números del local separados por coma, en cualquier formato (ej: 11 3639 7582)
ASTROBURGUER_ENCARGADOS=
ASTROBURGUER_COCINA=

# --- Demo web (/demo/<local>?t=DEMO_TOKEN). Si está vacío, la demo queda abierta a cualquiera con el link ---
DEMO_TOKEN=

# --- Servidor ---
PUBLIC_URL=https://tu-dominio.com
PORT=3000
DATA_DIR=data
# Espera para juntar mensajes seguidos del cliente (ms)
ESPERA_RAFAGA_MS=1500
# Consultas a la IA en paralelo (entre todos los locales). Subilo según el nivel de tu cuenta de Anthropic.
IA_EN_PARALELO=40

# --- Comidas JN ---
COMIDAS_JN_WA_PHONE_ID=
COMIDAS_JN_WA_TOKEN=
COMIDAS_JN_PANEL_TOKEN=
COMIDAS_JN_ENCARGADOS=
COMIDAS_JN_COCINA=
