{
  "name": "mostrador",
  "version": "1.3.0",
  "private": true,
  "description": "Mostrador: bot de pedidos por WhatsApp para rotiserías, pizzerías y hamburgueserías",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env --import tsx src/server.ts",
    "chat": "node --no-warnings --env-file-if-exists=.env --import tsx src/cli.ts",
    "test": "node --no-warnings --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "nuevo-local": "tsx scripts/nuevo-local.ts",
    "carga": "node --no-warnings --import tsx scripts/carga.ts",
    "check": "npm run typecheck && npm test",
    "validar": "node --no-warnings --import tsx scripts/validar.ts",
    "ensayo": "node --no-warnings --env-file-if-exists=.env --import tsx scripts/ensayo.ts",
    "demo-guiada": "node --no-warnings --import tsx scripts/demo-guiada.ts",
    "probar-comprobante": "node --no-warnings --env-file-if-exists=.env --import tsx scripts/probar-comprobante.ts",
    "analizar-chats": "node --no-warnings --env-file-if-exists=.env --import tsx scripts/analizar-chats.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "express": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "license": "UNLICENSED"
}
