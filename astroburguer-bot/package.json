{
  "name": "astroburguer-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de WhatsApp para tomar pedidos de Astroburguer (delivery y take away)",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "chat": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "test": "node --no-warnings --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "nuevo-local": "tsx scripts/nuevo-local.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
