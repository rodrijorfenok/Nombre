# --- Claude (IA) ---
ANTHROPIC_API_KEY=
# Modelo y esfuerzo (low = respuestas más rápidas y baratas; medium si notás errores)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=elegi-una-palabra-secreta
GRAPH_API_VERSION=v23.0

# --- Local ---
# Números con código de país, sin + ni espacios (ej: 5491155554444). Separar con comas.
STAFF_NUMBERS=
KITCHEN_NUMBERS=
# Clave para abrir el panel: https://tu-dominio/panel?token=...
PANEL_TOKEN=
PUBLIC_URL=https://tu-dominio.com
PORT=3000
DB_PATH=data/astroburguer.db
